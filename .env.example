# PostgreSQL local (crie o banco antes de executar a migração)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/assistente_precificacao

# Usadas somente pelo docker-compose.yml. Defina uma senha forte e use o mesmo valor em DATABASE_URL.
POSTGRES_DB=assistente_precificacao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-local-segura

# Use uma sequência aleatória com pelo menos 32 caracteres. Nunca versione o .env.
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa-com-32-caracteres

PORT=3000
NODE_ENV=development

# Em produção, use HTTPS e mantenha este valor como true.
SESSION_COOKIE_SECURE=false

# Resend: crie uma API key e use um remetente de domínio verificado.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Assistente de Precificação <acesso@seudominio.com>

# URL pública sem barra final. Em desenvolvimento, mantenha localhost.
APP_URL=http://localhost:3000

# Opcional, usado apenas por `npm run email:test`.
EMAIL_TEST_TO=seu-email-de-teste@exemplo.com
